// The root of games.nubuza.com, the host for nubuza's games. Like apps-root: each game's Worker
// only answers under its own base path (games.nubuza.com/<slug>*), so this catch-all only gets
// what no game claims: robots.txt, the bare host (redirected to nubuza.com) and the friendly
// 404 (a symlink to ../public/404.html). Deploy from this directory with `npx wrangler deploy`.
{
  "name": "nubuza-games-root",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "games.nubuza.com/*", "zone_name": "nubuza.com" }]
}
