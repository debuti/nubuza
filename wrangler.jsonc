// Static-assets-only Worker: no `main` script, so every request is served
// straight from Cloudflare's edge cache and never invokes a Worker.
{
  "name": "nubuza",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "nubuza.com", "custom_domain": true },
    { "pattern": "www.nubuza.com", "custom_domain": true },
    // AdMob crawls app-ads.txt on the Play listing's developer website, and some
    // listings point at apps.nubuza.com, whose other paths belong to the app Workers.
    { "pattern": "apps.nubuza.com/app-ads.txt", "zone_name": "nubuza.com" }
  ]
}
